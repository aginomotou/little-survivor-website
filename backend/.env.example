APP_NAME="Little Survivor Beach Resort"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://littlesurvivorbeachresort.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=littlesurvivor
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Gmail SMTP — uses a 16-character Google App Password (never your Gmail login password)
# Generate one at https://myaccount.google.com/apppasswords (2-Step Verification must be enabled).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=littlesurvivorbeachresort@gmail.com
MAIL_PASSWORD=REPLACE_WITH_16_CHAR_GMAIL_APP_PASSWORD
MAIL_FROM_ADDRESS="littlesurvivorbeachresort@gmail.com"
MAIL_FROM_NAME="Little Survivor Beach Resort"
# Where the staff alert notification is sent.
MAIL_STAFF_ADDRESS="littlesurvivorbeachresort@gmail.com"

# CORS — comma-separated list of allowed frontend origins.
# "https://*.vercel.app" covers every Vercel deployment/preview URL.
# Never use * in production.
CORS_ALLOWED_ORIGINS=https://*.vercel.app,https://littlesurvivorbeachresort.com

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
