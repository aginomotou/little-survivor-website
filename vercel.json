{
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/backend/public/api/:path*",
      "destination": "https://little-survivor-website-production.up.railway.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://little-survivor-website-production.up.railway.app/api/:path*"
    },
    {
      "source": "/:path*.php",
      "destination": "/:path*.html"
    }
  ]
}