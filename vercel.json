{
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/index(.php|.html)?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/:path*.php",
      "destination": "/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/backend/public/api/:path*",
      "destination": "https://little-survivor-website-production.up.railway.app/api/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://little-survivor-website-production.up.railway.app/api/:path*"
    }
  ]
}